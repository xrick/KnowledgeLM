# .env
# ============================================
# DocAI RAG Application Configuration
# ============================================

# Application Settings
APP_NAME=DocAI
APP_VERSION=1.0.0
DEBUG=True

# LLM Provider (Ollama - already running)
LLM_PROVIDER=ollama
LLM_PROVIDER_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER_BASE_URL=http://192.168.200.48:11434/v1
# DEFAULT_LLM_MODEL=phi4-mini:3.8b
# LLM_MODEL_NAME=zephyr:7b  # Commented out: zephyr:7b is slower, using phi4-mini:3.8b instead
DEFAULT_LLM_MODEL=gpt-oss:20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Embedding Model (Ollama compatible)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# BGE-M3
EMBEDDING_MODEL_BGE_M3=BAAI/bge-m3
EMBEDDING_DIMENSION_BGE_M3=1024


# Vector Database (Milvus - persistent vector storage)
VECTOR_STORE_TYPE=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=docai_embeddings

# MongoDB (Chat History)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=docai
MONGODB_COLLECTION=chat_history

# Redis (Cache)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# File Upload Settings
UPLOAD_DIR=./uploadfiles
PDF_UPLOAD_DIR=./uploadfiles/pdf
ALLOWED_EXTENSIONS=["pdf"]
MAX_FILE_SIZE=20971520 #20MB #52428800  # 50MB - Increased from 10MB for larger PDF documents

# Text Chunking Settings
# RecursiveCharacterTextSplitter is most effective for PDF documents
CHUNKING_STRATEGY=recursive  # "hierarchical" or "recursive" or "page_based"
HIERARCHICAL_CHUNK_SIZES=[2000, 1000, 500]
HIERARCHICAL_OVERLAP=100
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_SEPARATORS=["\n\n", "\n", "。", "！", "？", " ", ""]
PAGE_BASED_CHUNK_SIZE=1024 #600
PAGE_BASED_CHUNK_OVERLAP=100 #100

# Retrieval Settings
RETRIEVAL_TOP_K=40  # Increased from 10 to 20 for better coverage (2025-12-06)
ENABLE_MULTIVECTOR_RETRIEVAL=True

# SQLite Database (File Metadata)
DATABASE_URL=sqlite:///./data/skill_metadata.db  #docai.db

# CORS Settings
CORS_ORIGINS=["*"]

# Server Settings
HOST=0.0.0.0
PORT=8082
LOG_LEVEL=INFO
