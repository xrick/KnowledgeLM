🔍 統計 PDF 數量的方法
API Endpoint: GET /api/v1/skills/tree 程式碼位置: client.py:1253-1299

async def get_skill_tree(self) -> List[Dict[str, Any]]:
    """取得完整技能樹結構，包含 FAISS 向量數"""
    
    # 1. 獲取所有 skill_heads
    heads = await self.list_skill_heads(enabled_only=False)
    
    # 2. 對每個 head，獲取其下的所有文件（PDF）
    for head in heads:
        head['documents'] = await self.get_documents_for_head(head['head_id'])
        
        # 3. 加入 FAISS 向量統計
        for doc in head['documents']:
            index_stats = await get_index_stats(doc['skill_id'])
            doc['indexed_vectors'] = index_stats.get('vector_count', 0)
        
        # 4. 計算總數
        head['document_count'] = len(head['documents'])  # ✅ PDF 數量
        head['total_chunks'] = sum(doc['total_chunks'] for doc in head['documents'])
SQL 查詢邏輯:

-- 獲取每個技能的 PDF 數量
SELECT 
    h.skill_name as '技能名稱',
    COUNT(m.skill_id) as 'PDF文件數',
    SUM(m.total_chunks) as '總Chunks數'
FROM skill_heads h
LEFT JOIN skill_metadata m ON h.head_id = m.head_id
GROUP BY h.head_id;
