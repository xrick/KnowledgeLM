🔑 FAISS 索引載入機制
程式碼位置: client.py:618-671

def _try_lazy_load_store(self, store_id: str) -> Optional[Any]:
    """Lazy-load FAISS 索引（按需載入）"""
    
    # 1. 嘗試從 skills 目錄載入
    skill_path = self._faiss_skill_dir / store_id
    # → ./data/faiss_indices/skills/skill_xxx/
    
    if skill_path.exists():
        # 2. 準備 BGE-M3 embedding 模型（用於查詢向量化）
        bge_provider = get_bge_embedding_provider()
        skill_embeddings = BGEEmbeddingWrapper(bge_provider)
        
        # 3. 載入 FAISS 索引
        vector_store = FAISS.load_local(
            str(skill_path),
            skill_embeddings,
            allow_dangerous_deserialization=True  # 允許載入 PKL
        )
        # → 讀取 index.faiss + index.pkl
        
        return vector_store
載入的檔案:
index.faiss: 二進位向量索引
index.pkl: 文檔內容 + Metadata + 索引映射
🔍 FAISS 相似度搜尋
程式碼位置: client.py:498-592

def similarity_search_with_score(self, store_id, query, k=5):
    # 1. 確保索引已載入（Lazy Load）
    if store_id not in self._stores:
        vector_store = self._try_lazy_load_store(store_id)
        self._stores[store_id] = vector_store
    
    vector_store = self._stores[store_id]
    
    # 2. 執行 FAISS 相似度搜尋
    docs_with_scores = vector_store.similarity_search_with_score(query, k=k)
    # → 內部: query → BGE-M3 embedding → FAISS L2 search → top-k results
    
    # 3. 格式化結果
    results = []
    for doc, score in docs_with_scores:
        results.append({
            "content": doc.page_content,    # 原始文字
            "metadata": doc.metadata,       # chunk_id, page_number, etc.
            "score": float(score)           # L2 距離（越小越相似）
        })
    
    return results
🚀 多技能並行搜尋
程式碼位置: skills.py:472-503

# 當選擇多個 skills 時，並行搜尋
if len(content_ids) > 1:
    tasks = []
    for doc_id in content_ids[:10]:  # 限制最多 10 個
        task = retrieval_service.retrieve_context(
            query=query,
            content_ids=[doc_id],
            top_k=3,  # 每個 skill 取 3 個結果
            include_scores=True
        )
        tasks.append(task)
    
    # 並行執行
    all_results = await asyncio.gather(*tasks)
    
    # 合併結果
    context_results = []
    for results in all_results:
        context_results.extend(results)
    
    # 按分數排序，取最佳 top_k
    context_results.sort(key=lambda x: x.get('score', float('inf')))
    context_results = context_results[:top_k]
