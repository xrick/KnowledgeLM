# Step 1: 查詢 Main 包含的原始 PDF
main_documents = db.query("""
    SELECT source_file, file_path 
    FROM skill_metadata 
    WHERE skill_name = '大語言模型大全' 
    AND parent_skill_id = 'skill_xxxxx'  -- Main 的 skill_id
""")

# Result:
# - Build_a_LLM.pdf
# - LLM_Handbook.pdf

# Step 2: 為每個 PDF 生成獨立 index
for doc in main_documents:
    # 讀取原始 PDF
    content = extract_text(doc.file_path)
    
    # 分割 chunks
    chunks = text_splitter.split(content)
    
    # 生成 embeddings
    embeddings = embedding_service.embed_batch(chunks)
    
    # 儲存為獨立 index
    index = faiss.IndexFlatL2(dimension)
    index.add(embeddings)
    faiss.write_index(
        index, 
        f"data/faiss_indices/skills/大語言模型大全/{doc.source_file}.index"
    )

# Step 3: 刪除舊的 master.index（不再需要）
os.remove("data/faiss_indices/skills/大語言模型大全/master.index")
