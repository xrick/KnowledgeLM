async def migrate_skill_to_document_indices(skill_id: str):
    """
    將 skill 從 master index 遷移到文件級 indices
    """
    # 1. 查詢該 skill 的所有原始 PDF
    documents = await get_skill_documents(skill_id)
    
    # 2. 為每個 PDF 生成獨立 index
    for doc in documents:
        await generate_document_index(skill_id, doc)
    
    # 3. 更新資料庫（移除 parent_skill_id，改用 document_id）
    await update_database_schema(skill_id)
    
    # 4. 驗證遷移結果
    await verify_migration(skill_id)
    
    # 5. 刪除舊的 master.index
    cleanup_old_indices(skill_id)
